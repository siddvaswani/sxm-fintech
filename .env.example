# ──────────────────────────────────────────────────────────────────────────
#  Open Payments credentials  —  SERVER-SIDE ONLY. Never commit real values.
#  Copy this file to ".env" and fill in the blanks. ".env" is gitignored.
#  Create everything below at https://wallet.interledger-test.dev (see SETUP.md).
# ──────────────────────────────────────────────────────────────────────────

# These three identify OUR PLATFORM as the Open Payments "client". The platform
# signs requests but holds NO money — it is an initiator, not a custodian.

# The platform's own wallet address URL (used as the client identity).
CLIENT_WALLET_ADDRESS=https://ilp.interledger-test.dev/your-platform

# Key ID — shown in the test wallet's "Developer Keys" tab after you generate a key pair.
KEY_ID=

# Path to the private.key file you downloaded from the test wallet.
PRIVATE_KEY_PATH=./private.key

# ── The two businesses in the demo (created the same way in the test wallet) ──

# Business A — the SENDER. Create this wallet in USD.
SENDER_WALLET_ADDRESS=https://ilp.interledger-test.dev/business-a

# Business B — the RECEIVER. Create this wallet in XCG if the test wallet offers
# it, otherwise EUR or MXN. The app reads the currency dynamically — no code change.
RECEIVER_WALLET_ADDRESS=https://ilp.interledger-test.dev/business-b

# ── Consent redirect (Part 4) ──
# Base URL the test wallet redirects the browser back to after the sender approves a
# payment. The callback path /callback is appended automatically. Optional — defaults
# to http://localhost:3000 (the spec's value) if unset.
APP_BASE_URL=http://localhost:3000
